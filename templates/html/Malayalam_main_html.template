<!DOCTYPE html>
<html lang="ml">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>॥ \VAR{doc_title_sa} ॥ - Jaimineeya Samavedam</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+Grantha&family=Noto+Serif+Malayalam:wght@400;500;600;700&family=Noto+Sans+Malayalam:wght@400;500;600;700&family=Gayathri:wght@400;700&family=Manjari:wght@400;700&display=swap" rel="stylesheet">
    <style>
        @font-face {
            font-family: 'JaimineeyaSwara';
            \BLOCK{ if jaimineeya_swara_b64 }
            src: url('data:font/truetype;charset=utf-8;base64,\VAR{jaimineeya_swara_b64}') format('truetype');
            \BLOCK{ else }
            src: url('../../../fonts/JaimineeyaSwara.ttf') format('truetype'),
                 url('../../fonts/JaimineeyaSwara.ttf') format('truetype'),
                 url('../fonts/JaimineeyaSwara.ttf') format('truetype'),
                 url('fonts/JaimineeyaSwara.ttf') format('truetype');
            \BLOCK{ endif }
            font-weight: normal;
            font-style: normal;
        }

        @font-face {
            font-family: 'RIT Rachana';
            \BLOCK{ if rachana_regular_b64 }
            src: url('data:font/woff2;charset=utf-8;base64,\VAR{rachana_regular_b64}') format('woff2');
            \BLOCK{ else }
            src: url('../../../fonts/RIT-Rachana-Regular.woff2') format('woff2'),
                 url('../../fonts/RIT-Rachana-Regular.woff2') format('woff2'),
                 url('../fonts/RIT-Rachana-Regular.woff2') format('woff2'),
                 url('fonts/RIT-Rachana-Regular.woff2') format('woff2'),
                 url('/fonts/RIT-Rachana-Regular.woff2') format('woff2'),
                 url('https://cdn.jsdelivr.net/npm/malayalam-fonts@latest/fonts/RIT-Rachana/RIT-Rachana-Regular.woff2') format('woff2');
            \BLOCK{ endif }
            font-weight: normal;
            font-style: normal;
        }

        @font-face {
            font-family: 'RIT Rachana';
            \BLOCK{ if rachana_bold_b64 }
            src: url('data:font/woff2;charset=utf-8;base64,\VAR{rachana_bold_b64}') format('woff2');
            \BLOCK{ else }
            src: url('../../../fonts/RIT-Rachana-Bold.woff2') format('woff2'),
                 url('../../fonts/RIT-Rachana-Bold.woff2') format('woff2'),
                 url('../fonts/RIT-Rachana-Bold.woff2') format('woff2'),
                 url('fonts/RIT-Rachana-Bold.woff2') format('woff2'),
                 url('/fonts/RIT-Rachana-Bold.woff2') format('woff2'),
                 url('https://cdn.jsdelivr.net/npm/malayalam-fonts@latest/fonts/RIT-Rachana/RIT-Rachana-Bold.woff2') format('woff2');
            \BLOCK{ endif }
            font-weight: bold;
            font-style: normal;
        }

        :root {
            --font-doc: 'Noto Serif Malayalam', 'Noto Sans Malayalam', 'Gayathri', serif, sans-serif;
            --font-swara: 'JaimineeyaSwara', 'Noto Serif Grantha', serif;
            --font-size: 1.3rem;
            --mantra-size: calc(var(--font-size) * 1.25);
            --swara-size: var(--font-size);

            /* VedaVMS Palette */
            --saffron: #D84315;
            --maroon: #7B1113;
            --cream: #FFFDF9;
            --gold: #8B5A2B;
            --dark-brown: #2D1E18;
            --white: #FFFFFF;
            --border-color: #EADDC9;
            --accent-bg: #FFF3E0;

            /* JSV Semantic Palette */
            --primary-color: #000000;
            --accent-blue: #0d47a1;
            --accent-green: #1b5e20;
            --accent-purple: #4a148c;
            --accent-brown: #4e342e;
            --swara-red: #c62828;
            --modifier-color: #0284c7;
            --bg-light: #FBF8F2;
            --bg-card: #FFFFFF;

            /* Accent offsets */
            --swarita-bottom: 0.15em;
            --anudatta-bottom: -0.15em;
        }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 5rem;
            overflow-x: clip;
            width: 100%;
        }

        .chapter-container, .section, .subsection, .closing-mantras-section, #summary-table, #index, [id] {
            scroll-margin-top: 5rem;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        sup {
            vertical-align: top;
            position: relative;
            top: -0.6em;
            font-size: 0.75em;
        }

        body {
            font-family: var(--font-doc);
            background: var(--bg-light);
            color: var(--dark-brown);
            line-height: 1.9;
            font-size: var(--font-size);
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            overflow-x: clip;
            width: 100%;
            margin: 0;
            padding: 0;
        }

        /* Sticky Navigation Header Bar */
        .header {
            background: linear-gradient(135deg, #153E75 0%, #1D5296 50%, #2563A8 100%);
            color: white;
            padding: 0.85rem 1.25rem;
            text-align: center;
            border-bottom: 3px solid var(--gold);
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 3px 12px rgba(0,0,0,0.18);
        }

        .header-content {
            max-width: 1400px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.6rem;
        }

        .header-main-bar {
            display: flex;
            align-items: center;
            gap: 0.85rem;
            flex-shrink: 0;
        }

        .logo {
            font-family: 'Noto Serif Malayalam', serif;
            font-size: 1.35rem;
            font-weight: 700;
            color: white;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.45rem;
            flex-shrink: 0;
        }

        .om-symbol {
            color: #FFD54F;
            font-size: 1.6rem;
        }

        .header-quick-actions {
            display: flex;
            align-items: center;
            gap: 0.45rem;
        }

        .controls {
            display: flex;
            align-items: center;
            gap: 0.45rem;
            flex-wrap: wrap;
        }

        .zoom-controls {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
        }

        .btn-ctrl, .toggle-sidebar-btn {
            background: rgba(255,255,255,0.18);
            color: white;
            border: 1px solid rgba(255,255,255,0.35);
            border-radius: 6px;
            padding: 0.35rem 0.75rem;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.92rem;
            transition: all 0.2s;
            text-decoration: none;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            white-space: nowrap;
        }

        .btn-ctrl:hover, .toggle-sidebar-btn:hover {
            background: rgba(255,255,255,0.32);
            transform: translateY(-1px);
        }

        /* Suchi Drawer Backdrop */
        .toc-backdrop {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.55);
            backdrop-filter: blur(2px);
            z-index: 2400;
            opacity: 0;
            transition: opacity 0.25s ease;
        }

        /* 2-Column Responsive Layout */
        .layout {
            max-width: 1400px;
            margin: 1.5rem auto;
            padding: 0 1rem;
            display: grid;
            grid-template-columns: 320px 1fr;
            gap: 1.75rem;
            align-items: flex-start;
            transition: grid-template-columns 0.25s ease;
        }

        .layout.sidebar-collapsed {
            grid-template-columns: 0 1fr;
            gap: 0;
        }

        .layout.sidebar-collapsed .toc-sidebar {
            width: 0;
            min-width: 0;
            padding: 0;
            overflow: hidden;
            border: none;
            opacity: 0;
            pointer-events: none;
        }

        /* Sticky Collapsible TOC Sidebar */
        .toc-sidebar {
            background: var(--white);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 1.25rem 1rem;
            position: sticky;
            top: 5rem;
            max-height: calc(100vh - 6.5rem);
            overflow-y: auto;
            box-shadow: 0 4px 14px rgba(0,0,0,0.06);
            transition: opacity 0.2s ease, width 0.25s ease, padding 0.25s ease;
        }

        .toc-header-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid var(--saffron);
            padding-bottom: 0.4rem;
            margin-bottom: 0.85rem;
        }

        .toc-title {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--maroon);
            margin: 0;
            padding: 0;
            font-family: 'Noto Serif Malayalam', serif;
            text-align: left;
            border-bottom: none;
        }

        .toc-close-btn {
            display: none;
            align-items: center;
            justify-content: center;
            background: #F4ECE1;
            border: 1px solid var(--border-color);
            color: var(--maroon);
            font-size: 1.1rem;
            font-weight: 700;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            cursor: pointer;
            transition: all 0.2s ease;
            line-height: 1;
        }

        .toc-close-btn:hover {
            background: var(--accent-bg);
            color: var(--saffron);
            border-color: var(--saffron);
        }

        .toc-list {
            list-style: none;
        }

        .toc-chapter {
            margin-bottom: 0.75rem;
            border-bottom: 1px solid #F0E6D8;
            padding-bottom: 0.5rem;
        }
        .toc-chapter:last-child {
            border-bottom: none;
        }

        .toc-ch-header {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            cursor: pointer;
            padding: 0.4rem 0.5rem;
            border-radius: 6px;
            background: #FAF6F0;
            transition: background 0.15s;
        }

        .toc-ch-header:hover {
            background: var(--accent-bg);
        }

        /* Active Chapter header in TOC */
        .toc-chapter.active-chapter > .toc-ch-header {
            background: rgba(216, 67, 21, 0.08);
            border-radius: 6px;
            border-left: 3.5px solid var(--saffron);
            padding-left: 0.5rem;
        }

        .toc-chapter.active-chapter > .toc-ch-header .toc-ch-title a {
            color: var(--saffron);
            font-weight: 700;
        }


        .toc-ch-title {
            font-weight: 700;
            color: var(--maroon);
            font-size: 1.0rem;
            flex: 1;
        }

        .toc-ch-title a {
            color: inherit;
            text-decoration: none;
        }

        .toc-ch-toggle {
            font-size: 0.7rem;
            color: #888;
            transition: transform 0.2s;
        }

        .toc-chapter.collapsed .toc-ch-toggle {
            transform: rotate(-90deg);
        }

        .toc-sub-list {
            list-style: none;
            padding-left: 0.5rem;
            margin-top: 0.35rem;
            overflow: hidden;
            max-height: 5000px;
            transition: max-height 0.3s ease;
        }

        .toc-chapter.collapsed .toc-sub-list {
            max-height: 0;
            padding-top: 0;
            padding-bottom: 0;
        }

        /* Section (Kandah) Block in Sidebar */
        .toc-section-block {
            margin-bottom: 0.45rem;
            border-left: 2px solid #E8D9C8;
            padding-left: 0.5rem;
        }

        .toc-sec-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            padding: 0.25rem 0.4rem;
            border-radius: 4px;
            transition: background 0.15s;
        }

        .toc-sec-header:hover {
            background: var(--accent-bg);
        }

        .toc-sec-title {
            font-weight: 600;
            color: var(--accent-brown);
            font-size: 0.92rem;
            text-decoration: none;
            flex: 1;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .toc-sec-toggle {
            font-size: 0.65rem;
            color: #999;
            margin-left: 0.3rem;
            transition: transform 0.2s;
        }

        .toc-section-block.collapsed .toc-sec-toggle {
            transform: rotate(-90deg);
        }

        .toc-subsection-list {
            list-style: none;
            padding-left: 0.6rem;
            max-height: 2500px;
            overflow: hidden;
            transition: max-height 0.25s ease;
        }

        .toc-section-block.collapsed .toc-subsection-list {
            max-height: 0;
        }

        .toc-sub-item {
            margin-bottom: 0.2rem;
        }

        .toc-sub-item a {
            color: #4A4A4A;
            font-size: 0.85rem;
            padding: 0.2rem 0.35rem;
            display: block;
            border-radius: 3px;
            text-decoration: none;
            transition: all 0.15s;
            line-height: 1.35;
        }

        .toc-sub-item a:hover {
            background: var(--accent-bg);
            color: var(--saffron);
            font-weight: 600;
            padding-left: 0.5rem;
        }

        .toc-sub-item a.active {
            background: #FFE8D1 !important;
            color: #B23600 !important;
            font-weight: 700 !important;
            border-left: 3.5px solid var(--saffron);
            padding-left: 0.6rem;
            border-radius: 0 4px 4px 0;
            box-shadow: 0 1px 3px rgba(216, 67, 21, 0.12);
        }

        .toc-sec-header.active {
            background: #FFF3E0;
            border-left: 2px solid var(--saffron);
            font-weight: 700;
        }

        .toc-count {
            color: #888;
            font-size: 0.80rem;
            font-weight: normal;
        }

        /* Main Reading Area */
        .main-content {
            background: var(--white);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 2.25rem 2.75rem;
            box-shadow: 0 4px 16px rgba(0,0,0,0.06);
            min-width: 0;
            --font-size: 1.3rem;
            --mantra-size: calc(var(--font-size) * 1.25);
            --swara-size: var(--font-size);
            font-size: var(--font-size);
        }

        .main-title {
            text-align: center;
            margin-bottom: 2.5rem;
            padding-bottom: 1.25rem;
            border-bottom: 2px solid var(--gold);
        }

        .main-title h1 {
            font-family: var(--font-doc);
            font-size: 2.75rem;
            color: var(--maroon);
            margin-bottom: 0.5rem;
            letter-spacing: 0.5px;
        }

        .main-title .sub-heading {
            font-size: 1.15rem;
            color: var(--saffron);
            font-weight: 600;
        }

        .chapter-container {
            margin-bottom: 3.5rem;
        }

        .chapter-heading {
            background: linear-gradient(90deg, #7B1113 0%, #A52A2A 100%);
            color: white;
            padding: 0.85rem 1.5rem;
            border-radius: 8px;
            text-align: center;
            font-size: 2.25rem;
            font-weight: bold;
            margin-bottom: 1.75rem;
            font-family: var(--font-doc);
            box-shadow: 0 3px 8px rgba(123,17,19,0.25);
        }

        .section {
            margin-bottom: 2.25rem;
        }

        .section-title {
            text-align: center;
            font-size: 1.85rem;
            font-weight: bold;
            color: var(--maroon);
            margin-bottom: 1.25rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px dashed #E0D0C0;
            font-family: var(--font-doc);
        }

        .section-samam-count {
            color: #777;
            font-size: 0.85em;
            font-weight: normal;
        }

        /* Subsection Mantra Card */
        .subsection {
            background: #FFFAF5;
            border: 1px solid #F0E6D8;
            border-left: 5px solid var(--saffron);
            border-radius: 8px;
            padding: 1.25rem 1.6rem;
            margin-bottom: 1.75rem;
            box-shadow: 0 2px 6px rgba(0,0,0,0.03);
            text-align: center;

        }

        .subsection-header {
            text-align: center;
            margin-bottom: 0.85rem;
            padding-bottom: 0.4rem;
            border-bottom: 1px dotted #E0D0C0;
        }

        .subsection-header .header-title {
            color: var(--accent-green);
            font-weight: bold;
            font-size: 1.45rem;
            line-height: 1.4;
            display: inline-block;
        }

        .subsection-header .header-meta {
            color: var(--accent-brown);
            font-size: 1.15rem;
            margin-left: 10px;
        }

        /* Rik-Samam Separate Layout */
        .rik-metadata {
            color: var(--accent-purple);
            font-size: 1.05rem;
            margin-bottom: 6px;
            line-height: 1.6;
        }

        .rik-text {
            color: var(--accent-blue);
            font-size: var(--mantra-size);
            line-height: 2;
            letter-spacing: 0.02em;
            margin-bottom: 12px;
            padding-bottom: 8px;
            border-bottom: 1px dotted var(--border-color);
        }

        .samam-metadata {
            color: var(--accent-brown);
            font-size: 1.05rem;
            margin-bottom: 6px;
            line-height: 1.6;
        }

        .samam-text {
            font-size: var(--mantra-size);
            line-height: 2;
            letter-spacing: 0.02em;
            margin-bottom: 0;
        }

        /* Mantra Display - Flexbox for authentic alignment and wrapping */
        .mantra-verse {
            margin: 6px 0;
            display: inline-flex;
            flex-wrap: wrap;
            align-items: flex-end;
            justify-content: center;
            text-align: center;
            gap: 0;
            width: 100%;
        }

        .mantra-connected-group {
            display: inline-flex;
            flex-wrap: nowrap;
            align-items: flex-end;
            white-space: nowrap;
            margin: 0;
            padding: 0;
        }

        .mantra-word {
            display: inline-flex;
            align-items: flex-end;
            vertical-align: bottom;
            margin: 0;
            padding: 0;
            position: relative;
        }

        /* Ruby Stacking for Malayalam Vedic Swaras */
        ruby.vedic-ruby {
            ruby-position: over;
            ruby-align: center;
            display: inline-flex;
            flex-direction: column-reverse;
            align-items: center;
            vertical-align: bottom;
            margin: 0;
            padding: 0;
            position: relative;
        }

        rt.swara-above {
            font-family: var(--font-swara);
            font-size: var(--swara-size);
            color: var(--swara-red) !important;
            font-weight: 700;
            line-height: 1;
            display: flex;
            align-items: flex-end;
            justify-content: center;
            margin-bottom: 4px;
            user-select: text;
            white-space: nowrap;
        }

        rb.akshara-base,
        .akshara-base {
            font-family: var(--font-doc);
            font-size: var(--mantra-size);
            color: var(--primary-color);
            display: inline-flex;
            align-items: flex-end;
            justify-content: center;
            line-height: 1.25;
            text-align: center;
            position: relative;
        }

        \BLOCK{ if kpully }
        /* KPULLY (Kodunthirapully Paddhati): Swara text rendered ABOVE mantra text */
        ruby.vedic-ruby {
            flex-direction: column-reverse;
            align-items: center;
        }
        \BLOCK{ endif }

        .word-space {
            display: inline-block;
            width: 0.35em;
        }

        .danda {
            font-family: var(--font-doc);
            font-size: var(--mantra-size);
            line-height: 1.25;
            margin: 0 0.08em;
            vertical-align: baseline;
            display: inline;
        }

        .verse-num-marker {
            display: inline-flex;
            align-items: center;
            margin-left: 0.45em;
            white-space: nowrap;
            font-family: var(--font-doc);
            font-size: var(--mantra-size);
            line-height: 1.25;
            vertical-align: baseline;
        }

        .verse-num-marker .danda {
            margin: 0;
        }

        .verse-num {
            font-family: var(--font-doc);
            font-size: var(--mantra-size);
            font-weight: bold;
            color: var(--primary-color);
            padding: 0 0.12em;
            line-height: 1.25;
            vertical-align: baseline;
            display: inline;
        }

        /* Swara Modifiers */
        .swara-mod {
            font-family: var(--font-swara), var(--font-doc);
            color: var(--modifier-color);
            font-weight: 800;
            -webkit-text-stroke: 0.025em currentColor;
            line-height: 1;
            display: inline-block;
            vertical-align: baseline;
        }

        .swara-mod.mod-a {
            position: absolute;
            top: -0.32em;
            left: 100%;
            transform: translateX(-40%);
            font-size: 0.60em;
            pointer-events: none;
            z-index: 2;
        }

        .danda-with-arc,
        .danda.danda-with-arc {
            position: relative;
            display: inline-block;
            margin-left: 0;
            margin-right: 0;
        }

        .danda-with-arc .swara-mod.mod-a1,
        .danda.danda-with-arc .swara-mod.mod-a1,
        .swara-mod.mod-a1 {
            position: absolute;
            top: -0.22em;
            left: 62%;
            transform: translateX(-50%);
            font-size: 1.0em;
            pointer-events: none;
            z-index: 2;
        }

        .swara-mod.mod-a2 {
            position: absolute;
            top: -0.32em;
            left: 50%;
            transform: translateX(-50%);
            font-size: 0.60em;
            pointer-events: none;
            z-index: 2;
        }

        .swara-mod.mod-b {
            position: absolute;
            top: -0.28em;
            left: 100%;
            transform: translateX(-45%);
            font-size: 0.50em;
            pointer-events: none;
            z-index: 2;
        }

        .swara-mod.mod-b .caret-glyph {
            display: block;
            color: var(--modifier-color);
            font-size: 0.95rem;
            line-height: 1;
        }

        .swara-mod.mod-b .swara-on-caret {
            position: absolute;
            top: -1.70em;
            left: 50%;
            transform: translateX(-50%);
            color: var(--swara-red) !important;
            font-size: 0.70rem;
            font-weight: bold;
            font-family: var(--font-swara);
            line-height: 1;
            white-space: nowrap;
        }

        .swara-mod.mod-b1 {
            position: absolute;
            top: -0.35em;
            left: 100%;
            transform: translateX(-20%);
            font-size: 0.95rem;
            pointer-events: none;
        }

        .swara-mod.mod-c {
            position: absolute;
            top: -0.20em;
            left: 100%;
            transform: translateX(-0.20em);
            font-size: 0.90em;
            font-weight: 800;
            -webkit-text-stroke: 0.03em currentColor;
            pointer-events: none;
            z-index: 2;
        }

        .swara-mod.mod-d {
            position: absolute;
            top: -0.28em;
            left: 100%;
            transform: translateX(-45%);
            font-size: 0.60em;
            pointer-events: none;
            z-index: 2;
        }

        .swara-mod.mod-d1 {
            position: absolute;
            top: -0.24em;
            left: 100%;
            transform: translateX(-35%);
            font-size: 0.85em;
            pointer-events: none;
            z-index: 2;
        }

        .swara-mod.mod-d2 {
            font-size: 0.48em;
            margin-left: 1px;
            vertical-align: 0.35em;
        }

        .swara-mod.mod-e {
            font-size: 0.50em;
            margin-left: 1px;
            vertical-align: -0.15em;
        }

        .swara-mod.mod-f {
            font-size: 0.95em;
            font-weight: 900 !important;
            -webkit-text-stroke: 0.055em currentColor;
            text-shadow: 0.02em 0 currentColor, -0.02em 0 currentColor;
            margin-left: 2px;
            vertical-align: 0.12em;
            display: inline-block;
        }

        .syl-mod-g-wrap {
            position: relative;
            display: inline-flex;
            align-items: flex-end;
        }

        .swara-mod.mod-g,
        .syl-mod-g-wrap .swara-mod.mod-g {
            position: absolute;
            bottom: 0.12em;
            left: 50%;
            transform: translateX(-50%) translateX(-0.16em);
            font-size: 0.55em;
            pointer-events: none;
        }

        .swara-mod.mod-h {
            position: absolute;
            top: -0.32em;
            left: 100%;
            transform: translateX(-0.40em);
            font-size: 0.55em;
            pointer-events: none;
        }

        .swara-mod.mod-i {
            font-family: var(--font-swara);
            font-size: 1.45rem;
            font-weight: bold;
            color: var(--modifier-color);
            position: absolute;
            top: -0.25em;
            right: -0.25em;
            line-height: 1;
            pointer-events: none;
        }

        .swara-mod.mod-j {
            font-family: var(--font-swara);
            font-size: 1.45rem;
            font-weight: bold;
            color: var(--modifier-color);
            position: absolute;
            top: -0.28em;
            right: -0.20em;
            line-height: 1;
            pointer-events: none;
        }

        .swara-mod.mod-k {
            font-family: var(--font-swara);
            font-size: 1.45rem;
            font-weight: bold;
            color: var(--modifier-color);
            position: absolute;
            top: -0.25em;
            right: -0.50em;
            line-height: 1;
            pointer-events: none;
        }

        .swara-mod.mod-under,
        .swara-mod.mod-underbar {
            font-family: var(--font-doc);
            font-size: 1.1em;
            color: var(--modifier-color);
            display: inline;
            margin-left: -0.06em;
            margin-right: 0.02em;
            font-weight: 900;
            -webkit-text-stroke: 0.04em currentColor;
            position: relative;
            bottom: 0.12em;
            line-height: 1;
        }

        .swara-mod.mod-dot {
            font-family: var(--font-doc);
            color: var(--modifier-color);
            display: inline-block;
            margin: 0;
            font-size: 1.25em;
            font-weight: 800;
            -webkit-text-stroke: 0.035em currentColor;
            vertical-align: baseline;
        }

        .swara-mod.mod-comma {
            font-family: var(--font-doc);
            color: var(--modifier-color);
            display: inline-block;
            margin: 0;
            font-size: 0.95em;
            font-weight: normal;
            -webkit-text-stroke: 0;
            vertical-align: baseline;
        }

        .mantra-punct {
            font-family: var(--font-doc);
            font-size: var(--mantra-size);
            line-height: 1.25;
            color: var(--modifier-color);
            margin-right: 0.05em;
        }

        .mantra-connected-group .danda {
            margin: 0;
        }
        .danda.danda-adjacent {
            margin-left: -0.28em !important;
            margin-right: 2px !important;
        }

        /* Combining Accent Fallback for Rik Text */
        .accent-swarita {
            display: inline-block;
            width: 0;
            overflow: visible;
            color: inherit;
            font-family: 'AdishilaVedic', 'Noto Sans Devanagari', 'JaimineeyaSwara', sans-serif;
            font-weight: bold;
            font-size: 1.2em;
            position: relative;
            left: 0;
            bottom: var(--swarita-bottom);
            isolation: isolate;
        }
        .accent-anudatta {
            display: inline-block;
            width: 0;
            overflow: visible;
            color: inherit;
            font-family: 'AdishilaVedic', 'Noto Sans Devanagari', 'JaimineeyaSwara', sans-serif;
            font-weight: bold;
            font-size: 1.2em;
            position: relative;
            left: 0;
            bottom: var(--anudatta-bottom);
            isolation: isolate;
        }
        .accent-kampa, .accent-trikampa {
            display: inline-block;
            width: 0;
            overflow: visible;
            color: inherit;
            font-family: 'AdishilaVedic', 'Noto Sans Devanagari', 'JaimineeyaSwara', sans-serif;
            font-weight: bold;
            font-size: 1.2em;
            position: relative;
            left: 0;
            bottom: var(--anudatta-bottom);
        }

        /* Footnotes */
        .footnote-separator {
            border: none;
            border-top: 1px solid var(--border-color);
            margin: 18px 0 10px 0;
            width: 40%;
            margin-left: 0;
        }
        .footnote-section {
            padding: 8px 0;
            text-align: left;
            font-size: 0.92rem;
            line-height: 1.5;
        }
        .footnote-item {
            padding: 4px 0;
            display: flex;
            align-items: flex-start;
        }
        .footnote-item .footnote-ref {
            color: var(--accent-blue);
            font-weight: bold;
            margin-right: 0.5em;
            min-width: 1.5em;
        }

        /* Footer */
        .footer {
            text-align: center;
            padding: 2rem 1rem;
            margin-top: 3rem;
            border-top: 2px solid var(--border-color);
            color: var(--dark-brown);
            font-size: 0.95rem;
        }
        .footer a {
            color: var(--accent-blue);
            text-decoration: none;
            font-weight: bold;
        }
        .footer a:hover {
            text-decoration: underline;
        }

        /* Print Modal Styles */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.45);
            backdrop-filter: blur(2px);
            z-index: 2000;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .modal-card {
            background: white;
            border-radius: 12px;
            padding: 1.5rem;
            max-width: 540px;
            width: 92%;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
            border: 1px solid var(--border-color);
            box-sizing: border-box;
            overflow: hidden;
        }
        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 0.75rem;
            margin-bottom: 1rem;
        }
        .modal-header h3 {
            color: var(--maroon);
            font-size: 1.25rem;
            font-family: 'Noto Serif Malayalam', serif;
        }
        .close-modal-btn {
            background: none;
            border: none;
            font-size: 1.25rem;
            cursor: pointer;
            color: #888;
        }
        .close-modal-btn:hover {
            color: var(--maroon);
        }
        .print-options {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }
        .btn-print-opt {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 0.85rem 1rem;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            background: #FFFDF9;
            cursor: pointer;
            text-align: left;
            transition: all 0.2s;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }
        .btn-print-opt:hover {
            background: var(--accent-bg);
            border-color: var(--gold);
            transform: translateY(-1px);
        }
        .btn-print-opt.primary {
            border-color: var(--saffron);
            background: #FFF8EE;
        }
        .btn-opt-icon {
            font-size: 1.6rem;
        }
        .btn-opt-text {
            display: flex;
            flex-direction: column;
        }
        .btn-opt-text strong {
            font-size: 1rem;
            color: var(--dark-brown);
        }
        .btn-opt-text span {
            font-size: 0.82rem;
            color: #666;
        }

        @media (max-width: 600px), (max-width: 850px) and (pointer: coarse), (max-height: 550px) and (orientation: landscape) and (pointer: coarse) {
            .header {
                padding: 0.45rem 0.6rem;
            }

            .header-content {
                flex-direction: column;
                align-items: stretch;
                gap: 0.35rem;
            }

            .header-main-bar {
                display: flex;
                justify-content: space-between;
                align-items: center;
                width: 100%;
            }

            .logo {
                font-size: 1.15rem;
                min-width: 0;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .om-symbol {
                font-size: 1.45rem;
            }

            .header-quick-actions {
                display: flex;
                align-items: center;
                gap: 0.35rem;
                flex-shrink: 0;
            }

            .controls {
                display: flex;
                flex-wrap: wrap;
                justify-content: center;
                align-items: center;
                gap: 0.3rem;
                width: 100%;
            }

            .zoom-controls {
                display: inline-flex;
                align-items: center;
                gap: 0.2rem;
            }

            .btn-ctrl, .toggle-sidebar-btn {
                padding: 0.3rem 0.52rem;
                font-size: 0.8rem;
                border-radius: 5px;
            }

            #font-toggle-btn {
                max-width: 125px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            #font-size-val {
                min-width: 36px !important;
                font-size: 0.78rem !important;
                padding: 0.1rem 0.25rem !important;
            }

            .layout {
                display: block !important;
                grid-template-columns: 1fr !important;
                width: 100% !important;
                max-width: 100% !important;
                margin: 0.75rem auto;
                padding: 0 0.5rem;
                box-sizing: border-box;
            }

            /* Suchi Drawer for Mobile View */
            .toc-sidebar {
                position: fixed !important;
                top: 0 !important;
                left: 0 !important;
                bottom: 0 !important;
                width: min(85vw, 340px) !important;
                height: 100vh !important;
                max-height: 100vh !important;
                background: #FFFDF9 !important;
                border: none !important;
                border-right: 3px solid var(--saffron) !important;
                border-radius: 0 16px 16px 0 !important;
                box-shadow: 10px 0 35px rgba(0, 0, 0, 0.35) !important;
                z-index: 2500 !important;
                padding: 1.25rem 1rem 2.5rem 1.25rem !important;
                overflow-y: auto !important;
                -webkit-overflow-scrolling: touch;
                transform: translateX(-105%);
                transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1) !important;
                display: block !important;
                opacity: 1 !important;
                pointer-events: auto !important;
            }

            body.mobile-toc-active {
                overflow: hidden !important;
            }

            body.mobile-toc-active .toc-backdrop {
                display: block;
                opacity: 1;
            }

            body.mobile-toc-active .toc-sidebar {
                transform: translateX(0) !important;
            }

            .toc-close-btn {
                display: inline-flex;
            }

            .main-content {
                padding: 1.15rem 0.85rem;
                width: 100%;
                box-sizing: border-box;
                border-radius: 8px;
            }

            .main-title {
                margin-bottom: 1.75rem;
                padding-bottom: 0.85rem;
            }

            .main-title h1 {
                font-size: 1.55rem;
                line-height: 1.35;
                word-break: break-word;
                overflow-wrap: break-word;
            }

            .main-title .sub-heading {
                font-size: 0.95rem;
            }

            .chapter-container {
                margin-bottom: 2.25rem;
            }

            .chapter-heading {
                font-size: 1.25rem;
                padding: 0.7rem 0.95rem;
                border-radius: 6px;
                margin-bottom: 1.25rem;
                word-break: break-word;
                overflow-wrap: break-word;
            }

            .section-title {
                font-size: 1.15rem;
                margin-bottom: 1rem;
            }

            .subsection {
                padding: 0.95rem 0.85rem;
                margin-bottom: 1.25rem;
                border-left-width: 4px;
            }

            .subsection-header .header-title {
                font-size: 1.15rem;
            }

            .summary-table-container {
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
                width: 100%;
            }
        }

        @media (max-height: 550px) and (orientation: landscape) {
            .header {
                padding: 0.25rem 0.55rem;
            }
            .header-content {
                flex-direction: row;
                justify-content: space-between;
                align-items: center;
                gap: 0.3rem;
                flex-wrap: wrap;
            }
            .header-main-bar {
                display: flex;
                align-items: center;
                gap: 0.3rem;
                width: auto;
            }
            .logo {
                font-size: 1.15rem;
            }
            .controls {
                display: flex;
                align-items: center;
                gap: 0.25rem;
                width: auto;
                flex-wrap: wrap;
            }
            .btn-ctrl, .toggle-sidebar-btn {
                padding: 0.25rem 0.45rem;
                font-size: 0.78rem;
            }
            #font-toggle-btn {
                max-width: 110px;
            }
        }

        @media (max-width: 420px) {
            .header {
                padding: 0.35rem 0.45rem;
            }

            .logo {
                font-size: 1.05rem;
            }

            .btn-ctrl, .toggle-sidebar-btn {
                padding: 0.26rem 0.4rem;
                font-size: 0.76rem;
            }

            #font-toggle-btn {
                max-width: 100px;
            }

            .main-content {
                padding: 0.95rem 0.65rem;
            }
        }

        /* Floating Back to Top Button */
        .back-to-top {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            background: linear-gradient(135deg, #153E75 0%, #2563A8 100%);
            color: white;
            border: 2px solid var(--gold);
            border-radius: 50%;
            width: 46px;
            height: 46px;
            font-size: 1.2rem;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 4px 14px rgba(0,0,0,0.25);
            opacity: 0;
            visibility: hidden;
            transition: all 0.25s ease;
            z-index: 1000;
        }
        .back-to-top.visible {
            opacity: 1;
            visibility: visible;
        }
        .back-to-top:hover {
            background: var(--maroon);
            transform: translateY(-3px);
            box-shadow: 0 6px 18px rgba(123,17,19,0.35);
        }

        /* High Performance Print Optimization */
        @media print {
            @page {
                size: auto;
                margin: 12mm 15mm 12mm 15mm;
            }
            .header, .toc-sidebar, .footer, .modal-overlay, #print-modal, .back-to-top, .btn-heading-print {
                display: none !important;
            }
            *, *::before, *::after {
                box-shadow: none !important;
                text-shadow: none !important;
                filter: none !important;
                box-sizing: border-box !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
            body {
                background: white !important;
                color: black !important;
                font-size: 12pt !important;
                line-height: 1.5 !important;
                width: 100% !important;
                max-width: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            .layout {
                display: block !important;
                width: 100% !important;
                max-width: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            .main-content {
                box-shadow: none !important;
                border: none !important;
                padding: 0 !important;
                width: 100% !important;
                max-width: 100% !important;
            }
            .chapter-heading {
                background: none !important;
                color: black !important;
                border-bottom: 2pt solid black !important;
                box-shadow: none !important;
                padding: 0.5rem 0 !important;
                font-size: 15pt !important;
                width: 100% !important;
            }
            .section-title {
                color: black !important;
                border-bottom: 1pt dashed #666 !important;
                padding: 0.3rem 0 !important;
                font-size: 13pt !important;
                width: 100% !important;
            }
            .subsection {
                background: none !important;
                border: 1px solid #CCC !important;
                border-left: 4px solid var(--saffron) !important;
                border-radius: 6px !important;
                box-shadow: none !important;
                padding: 10px 14px !important;
                margin-bottom: 1rem !important;
                width: 100% !important;
                max-width: 100% !important;
                box-sizing: border-box !important;
                break-inside: auto !important;
                page-break-inside: auto !important;
                content-visibility: visible !important;
            }
            .mantra-verse {
                break-inside: auto !important;
                page-break-inside: auto !important;
                width: 100% !important;
                max-width: 100% !important;
                flex-wrap: wrap !important;
                box-sizing: border-box !important;
            }
            .mantra-connected-group {
                max-width: 100% !important;
                flex-wrap: wrap !important;
            }
            ruby.vedic-ruby {
                display: inline-flex !important;
                flex-direction: column-reverse !important;
                align-items: center !important;
                vertical-align: bottom !important;
            }
            rt.swara-above {
                font-size: 0.85em !important;
                color: #c62828 !important;
            }
            .chapter-container {
                break-before: page !important;
                page-break-before: always !important;
            }
            .chapter-container:first-of-type {
                break-before: auto !important;
                page-break-before: auto !important;
            }
        }
    </style>
</head>
<body>
    <!-- Sticky Navigation Header -->
    <header class="header">
        <div class="header-content">
            <div class="header-main-bar">
                <a href="#" class="logo" onclick="window.scrollTo({top: 0, behavior: 'smooth'}); return false;" title="Go to top of page">
                    <span class="om-symbol">ॐ</span>
                    <span class="logo-title">॥ \VAR{doc_title_sa} ॥</span>
                </a>
                <div class="header-quick-actions">
                    <button class="toggle-sidebar-btn" onclick="toggleSidebar()" title="Toggle Contents Panel (ഉള്ളടക്കം)" id="sidebar-toggle-btn" data-label="ഉള്ളടക്കം">☰ ഉള്ളടക്കം</button>
                    \BLOCK{ if summary_table }
                    <a href="#summary-table" class="btn-ctrl" title="View Counts Summary">॥ സംഖ്യ ॥</a>
                    \BLOCK{ endif }
                    \BLOCK{ if html_index }
                    <a href="#index" class="btn-ctrl" title="Alphabetical Index">॥ വർണ്ണാനുക്രമണിക ॥</a>
                    \BLOCK{ endif }
                </div>
            </div>
            <div class="controls">
                <button class="btn-ctrl" id="font-toggle-btn" onclick="toggleFont()" title="Toggle Malayalam Font">Font: Noto Serif</button>
                <div class="zoom-controls">
                    <button class="btn-ctrl" onclick="adjustFont(-1)" title="Decrease Font Size (A-)">A-</button>
                    <span id="font-size-val" onclick="resetFontSize()" style="font-size: 0.85rem; padding: 0.15rem 0.45rem; color: #FFF; font-family: monospace; font-weight: 600; min-width: 44px; text-align: center; display: inline-block; cursor: pointer; border-radius: 4px; background: rgba(255,255,255,0.14); transition: transform 0.15s ease;" title="Click to reset font size to 100%">100%</span>
                    <button class="btn-ctrl" onclick="adjustFont(1)" title="Increase Font Size (A+)">A+</button>
                </div>
                <button class="btn-ctrl" onclick="openPrintModal()" title="Print Options">🖨️ Print</button>
                <button class="btn-ctrl" onclick="window.scrollTo({top: 0, behavior: 'smooth'})" title="Go to top of page">▲ Top</button>
            </div>
        </div>
    </header>

    <div class="toc-backdrop" id="toc-backdrop" onclick="closeMobileToc()"></div>

    <!-- 2-Column Responsive Layout -->
    <div class="layout">
        <!-- Sticky TOC Sidebar -->
        <aside class="toc-sidebar" id="toc-sidebar">
            <div class="toc-header-bar">
                <div class="toc-title">॥ ഉള്ളടക്കം (Contents) ॥</div>
                <button class="toc-close-btn" onclick="closeMobileToc()" title="Close Contents" aria-label="Close">✕</button>
            </div>
            <ul class="toc-list">
            \BLOCK{ for key, supersection in supersections.items() }
                \BLOCK{ if key != 'count' }
                <li class="toc-chapter collapsed" id="toc-ss-\VAR{key}">
                    <div class="toc-ch-header" onclick="toggleTocChapter('toc-ss-\VAR{key}')">
                        \BLOCK{ if supersection.supersection_title }
                        <div class="toc-ch-title"><a href="#\VAR{key}">\VAR{supersection.supersection_title}</a></div>
                        \BLOCK{ else }
                        <div class="toc-ch-title"><a href="#\VAR{key}">\VAR{key}</a></div>
                        \BLOCK{ endif }
                        <span class="toc-ch-toggle">▼</span>
                    </div>
                    <ul class="toc-sub-list">
                    \BLOCK{ for section_key, section in supersection.sections.items() }
                        \BLOCK{ if section_key != 'count' }
                        <li class="toc-section-block collapsed" id="toc-sec-\VAR{key}-\VAR{section_key}">
                            \BLOCK{ if section.section_title }
                            <div class="toc-sec-header" onclick="toggleTocSection('toc-sec-\VAR{key}-\VAR{section_key}')">
                                <a href="#\VAR{key}-\VAR{section_key}" class="toc-sec-title">
                                    <span>\VAR{section.section_title | replace(':', 'ഃ')}</span>
                                    <span class="toc-count">(\VAR{section.Count})</span>
                                </a>
                                <span class="toc-sec-toggle">▾</span>
                            </div>
                            \BLOCK{ endif }
                            <ul class="toc-subsection-list">
                            \BLOCK{ for subsection_key, subsection in section.subsections.items() }
                                \BLOCK{ if subsection_key != 'count' and subsection.header }
                                \BLOCK{ set sub_title = subsection.header.header if subsection.header is mapping else subsection.header }
                                \BLOCK{ if sub_title }
                                <li class="toc-sub-item">
                                    <a href="#\VAR{key}-\VAR{section_key}-\VAR{subsection_key}">\VAR{sub_title | clean_toc_title | replace(':', 'ഃ') | replace('|', '') | replace('॥', '')}</a>
                                </li>
                                \BLOCK{ endif }
                                \BLOCK{ endif }
                            \BLOCK{ endfor }
                            </ul>
                        </li>
                        \BLOCK{ endif }
                    \BLOCK{ endfor }
                    </ul>
                </li>
                \BLOCK{ endif }
            \BLOCK{ endfor }
            \BLOCK{ if summary_table }
                <li class="toc-chapter" style="margin-top: 0.75rem;">
                    <div class="toc-ch-header" style="background: var(--accent-bg);">
                        <div class="toc-ch-title"><a href="#summary-table">॥ \VAR{summary_title} ॥</a></div>
                    </div>
                </li>
            \BLOCK{ endif }
            \BLOCK{ if html_index }
                <li class="toc-chapter">
                    <div class="toc-ch-header" style="background: var(--accent-bg);">
                        <div class="toc-ch-title"><a href="#index">॥ വർണ്ണാനുക്രമണിക ॥</a></div>
                    </div>
                </li>
            \BLOCK{ endif }
            </ul>
        </aside>

        <!-- Main Reading Content -->
        <main class="main-content">
            <!-- Title Header Card -->
            <div class="main-title">
                <h1>॥ \VAR{doc_title_sa} ॥</h1>
                <div class="sub-heading">പതിപ്പ്: \VAR{version} | നിർമ്മിതം: \VAR{generated_at}</div>
            </div>

            <!-- Chapters / Sections / Mantras -->
            \BLOCK{ for key, supersection in supersections.items() }
            \BLOCK{ if key != 'count' }
            <section class="chapter-container" id="\VAR{key}">
                \BLOCK{ if supersection.supersection_title }
                <h2 class="chapter-heading">\VAR{supersection.supersection_title}</h2>
                \BLOCK{ endif }
                
                \BLOCK{ for section_key, section in supersection.sections.items() }
                    \BLOCK{ if section_key != 'count' }
                    <div class="section" id="\VAR{key}-\VAR{section_key}">
                        \BLOCK{ if section.section_title }
                        <h3 class="section-title">\VAR{section.section_title | replace(':', 'ഃ')} <span class="section-samam-count">(\VAR{section.Count})</span></h3>
                        \BLOCK{ endif }
                        
                        <!-- Pre-rendered Subsections -->
                        \BLOCK{ for sub_html in section.html_subsections }
                        <div class="subsection" id="\VAR{sub_html.id}">
                            \VAR{sub_html.content}
                        </div>
                        \BLOCK{ endfor }

                        <!-- Pre-rendered Footnotes -->
                        \VAR{section.html_footer}
                    </div>
                    \BLOCK{ endif }
                \BLOCK{ endfor }
            </section>
            \BLOCK{ endif }
            \BLOCK{ endfor }
            
            \BLOCK{ if closing_mantras }
            <!-- Closing Mantras -->
            <div class="section closing-mantras-section" id="closing-mantras">
                <div class="subsection" style="padding: 25px 20px; margin: 20px 0; background: #FFF8EE; border-left-color: var(--maroon);">
                    \BLOCK{ for line in closing_mantras }
                    <p style="font-size: 1.45rem; margin: 8px 0; text-align: center; color: var(--maroon); font-weight: 600;">\VAR{line}</p>
                    \BLOCK{ endfor }
                </div>
            </div>
            \BLOCK{ endif }
            
            \BLOCK{ if summary_table }
            <!-- Summary Table Card -->
            \BLOCK{ set show_rik = ('rik' in output_mode or 'combined' in output_mode) and has_riks }
            \BLOCK{ set show_samam = ('samam' in output_mode or 'combined' in output_mode) and has_samams }
            <div class="section" id="summary-table" style="margin-top: 3rem;">
                <h2 class="chapter-heading">॥ \VAR{summary_title} ॥</h2>
                <div style="overflow-x: auto; padding: 10px; display: flex; justify-content: center;">
                    <table style="width: 100%; max-width: 850px; border-collapse: collapse; margin: 15px 0; text-align: center; border: 1px solid var(--border-color); border-radius: 8px; overflow: hidden;">
                        <thead>
                            <tr style="background: linear-gradient(90deg, #7B1113 0%, #A52A2A 100%); color: white;">
                                <th style="padding: 10px; border: 1px solid var(--border-color);">ഖണ്ഡഃ</th>
                                \BLOCK{ if show_rik }
                                <th style="padding: 10px; border: 1px solid var(--border-color);">ഋക് സംഖ്യ</th>
                                \BLOCK{ endif }
                                \BLOCK{ if show_samam }
                                <th style="padding: 10px; border: 1px solid var(--border-color);">സാമ സംഖ്യ</th>
                                \BLOCK{ endif }
                            </tr>
                        </thead>
                        <tbody>
                            \BLOCK{ for patha_data in summary_table }
                                <tr style="background-color: var(--accent-bg); font-weight: bold;">
                                    <td style="padding: 8px; border: 1px solid var(--border-color); color: var(--maroon);"><a href="#\VAR{patha_data.id}" style="color: inherit; text-decoration: none; display: block;">\VAR{patha_data.patha}</a></td>
                                    \BLOCK{ if show_rik }
                                    <td style="padding: 8px; border: 1px solid var(--border-color); color: var(--maroon);">\VAR{patha_data.patha_riks}</td>
                                    \BLOCK{ endif }
                                    \BLOCK{ if show_samam }
                                    <td style="padding: 8px; border: 1px solid var(--border-color); color: var(--maroon);">\VAR{patha_data.patha_samams}</td>
                                    \BLOCK{ endif }
                                </tr>
                                \BLOCK{ for row in patha_data.khandas }
                                <tr>
                                    <td style="padding: 6px; border: 1px solid var(--border-color); text-align: left; padding-left: 20px;"><a href="#\VAR{row.id}" style="color: #153E75; text-decoration: none; font-weight: 500;">\VAR{row.khanda}</a></td>
                                    \BLOCK{ if show_rik }
                                    <td style="padding: 6px; border: 1px solid var(--border-color);">\VAR{row.riks}</td>
                                    \BLOCK{ endif }
                                    \BLOCK{ if show_samam }
                                    <td style="padding: 6px; border: 1px solid var(--border-color);">\VAR{row.samams}</td>
                                    \BLOCK{ endif }
                                </tr>
                                \BLOCK{ endfor }
                            \BLOCK{ endfor }
                            \BLOCK{ if total_riks or total_samams }
                            <tr style="background-color: var(--accent-bg); font-weight: bold; border-top: 2px solid var(--border-color);">
                                <td style="padding: 10px; border: 1px solid var(--border-color); color: var(--maroon);">ആകെ (Total)</td>
                                \BLOCK{ if show_rik }
                                <td style="padding: 10px; border: 1px solid var(--border-color); color: var(--maroon);">\VAR{total_riks}</td>
                                \BLOCK{ endif }
                                \BLOCK{ if show_samam }
                                <td style="padding: 10px; border: 1px solid var(--border-color); color: var(--maroon);">\VAR{total_samams}</td>
                                \BLOCK{ endif }
                            </tr>
                            \BLOCK{ endif }
                        </tbody>
                    </table>
                </div>
            </div>
            \BLOCK{ endif }
            
            \BLOCK{ if html_index }
            <!-- Alphabetical Index -->
            <div class="section" id="index" style="margin-top: 3rem;">
                <h2 class="chapter-heading">॥ വർണ്ണാനുക്രമണിക ॥</h2>
                <div class="toc-content" style="display: block; columns: 3 220px; padding: 15px 20px;">
                    <ul style="list-style: none; padding-left: 0; margin: 0;">
                    \BLOCK{ for entry in html_index }
                        <li style="margin-bottom: 6px; text-align: left;">
                            <a href="#\VAR{entry.anchor}" style="text-decoration: none; color: var(--accent-blue); font-size: 1.05rem; word-break: break-word; display: inline-block;">\VAR{entry.title}</a>
                        </li>
                    \BLOCK{ endfor }
                    </ul>
                </div>
            </div>
            \BLOCK{ endif }

            <footer class="footer">
                <p>ജൈമിനീയ സാമവേദ സംഹിതാ — മലയാളം സംസ്‍കരണം | Visit us at <a href="https://jaimineeyasamavedam.org" target="_blank">jaimineeyasamavedam.org</a></p>
            </footer>
        </main>
    </div>

    <!-- Print Options Modal -->
    <div id="print-modal" class="modal-overlay" style="display: none;" onclick="if(event.target === this) closePrintModal();">
        <div class="modal-card" style="max-width: 580px;">
            <div class="modal-header">
                <h3>അച്ചടി ഓപ്ഷനുകൾ (Print Options)</h3>
                <button class="close-modal-btn" onclick="closePrintModal()">✕</button>
            </div>
            <div class="modal-body">
                <p style="margin-bottom: 1.1rem; color: #555; font-size: 0.92rem; line-height: 1.5;">
                    താഴെയുള്ളതിൽ നിന്ന് അച്ചടി പരിധി തിരഞ്ഞെടുക്കുക (Select print scope):
                </p>
                <div class="print-options">
                    <!-- Quick Print Active Scope -->
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.65rem;">
                        <button class="btn-print-opt primary" onclick="printActiveKandah()" style="margin: 0; padding: 0.75rem 0.85rem;">
                            <span class="btn-opt-icon" style="font-size: 1.4rem;">⚡</span>
                            <div class="btn-opt-text">
                                <strong style="font-size: 0.92rem;">സജീവ ഖണ്ഡം അച്ചടിക്കുക</strong>
                                <span id="current-kandah-print-name" style="font-size: 0.78rem;">Active Kandah (~1-3 pages)</span>
                            </div>
                        </button>
                        <button class="btn-print-opt" onclick="printActiveParva()" style="margin: 0; padding: 0.75rem 0.85rem; border-color: #C68A1E; background: #FFFBF2;">
                            <span class="btn-opt-icon" style="font-size: 1.4rem;">📑</span>
                            <div class="btn-opt-text">
                                <strong style="font-size: 0.92rem;">സജീവ പർവ്വം അച്ചടിക്കുക</strong>
                                <span id="current-parva-print-name" style="font-size: 0.78rem;">Active Parva / Chapter</span>
                            </div>
                        </button>
                    </div>
                    
                    <!-- Specific Parva (Supersection) Selection -->
                    <div style="background: #FFFDF9; border: 1px solid var(--border-color); border-radius: 8px; padding: 0.75rem 1rem; box-sizing: border-box; max-width: 100%; overflow: hidden;">
                        <label style="font-weight: 600; font-size: 0.90rem; color: var(--maroon); display: block; margin-bottom: 0.35rem;">
                            പർവ്വം തിരഞ്ഞെടുക്കുക (Select Supersection / Parva):
                        </label>
                        <div style="display: flex; gap: 0.5rem; align-items: center; width: 100%; max-width: 100%; box-sizing: border-box;">
                            <select id="parva-select-dropdown" style="flex: 1; min-width: 0; width: 0; padding: 0.45rem; border: 1px solid #CCC; border-radius: 6px; font-family: var(--font-doc); font-size: 0.90rem; box-sizing: border-box;">
                            </select>
                            <button type="button" class="btn-ctrl" style="background: #153E75; color: white; border: none; padding: 0.45rem 0.85rem; cursor: pointer; white-space: nowrap; flex-shrink: 0;" onclick="printSelectedParva()">Print Parva</button>
                        </div>
                    </div>

                    <!-- Specific Kandah (Section) Selection -->
                    <div style="background: #FFFDF9; border: 1px solid var(--border-color); border-radius: 8px; padding: 0.75rem 1rem; box-sizing: border-box; max-width: 100%; overflow: hidden;">
                        <label style="font-weight: 600; font-size: 0.90rem; color: var(--dark-brown); display: block; margin-bottom: 0.35rem;">
                            ഖണ്ഡം തിരഞ്ഞെടുക്കുക (Select Section / Kandah):
                        </label>
                        <div style="display: flex; gap: 0.5rem; align-items: center; width: 100%; max-width: 100%; box-sizing: border-box;">
                            <select id="kandah-select-dropdown" style="flex: 1; min-width: 0; width: 0; padding: 0.45rem; border: 1px solid #CCC; border-radius: 6px; font-family: var(--font-doc); font-size: 0.90rem; box-sizing: border-box;">
                            </select>
                            <button type="button" class="btn-ctrl" style="background: var(--saffron); color: white; border: none; padding: 0.45rem 0.85rem; cursor: pointer; white-space: nowrap; flex-shrink: 0;" onclick="printSelectedKandah()">Print Kandah</button>
                        </div>
                    </div>

                    <!-- Entire Document -->
                    <button class="btn-print-opt" onclick="printEntireDocument()">
                        <span class="btn-opt-icon">📖</span>
                        <div class="btn-opt-text">
                            <strong>പൂർണ്ണ സംഹിത അച്ചടിക്കുക (Print Entire Document)</strong>
                            <span>എല്ലാ പർവ്വങ്ങളും ഖണ്ഡങ്ങളും (All Parvas and Kandahs full text)</span>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        const fontList = [
            { label: "Noto Serif", font: "'Noto Serif Malayalam', 'Noto Sans Malayalam', serif" },
            { label: "Rachana", font: "'RIT Rachana', 'Rachana', 'Noto Serif Malayalam', serif" },
            { label: "Noto Sans", font: "'Noto Sans Malayalam', 'Noto Serif Malayalam', sans-serif" },
            { label: "Gayathri", font: "'Gayathri', 'Noto Serif Malayalam', sans-serif" },
            { label: "Manjari", font: "'Manjari', 'Noto Sans Malayalam', sans-serif" }
        ];
        let currentFontIndex = 0;
        function setFont(idx) {
            currentFontIndex = ((idx % fontList.length) + fontList.length) % fontList.length;
            const chosen = fontList[currentFontIndex];
            document.documentElement.style.setProperty('--font-doc', chosen.font);
            const btn = document.getElementById('font-toggle-btn');
            if (btn) btn.innerText = 'Font: ' + chosen.label;
            localStorage.setItem('jsv-ml-reader-font-idx', currentFontIndex);
        }
        function toggleFont() {
            setFont(currentFontIndex + 1);
        }

        let currentSize = 1.3;
        function updateFontSizeDisplay() {
            const pct = Math.round((currentSize / 1.3) * 100);
            const valEl = document.getElementById('font-size-val');
            if (valEl) {
                valEl.textContent = pct + '%';
                valEl.style.transform = 'scale(1.18)';
                setTimeout(() => { valEl.style.transform = 'scale(1)'; }, 150);
            }
        }

        function applyFontSize() {
            const mainEl = document.querySelector('.main-content');
            if (mainEl) mainEl.style.setProperty('--font-size', currentSize + 'rem');
            document.documentElement.style.setProperty('--font-size', currentSize + 'rem');
            updateFontSizeDisplay();
            localStorage.setItem('jsv-ml-reader-font-size', currentSize);
        }

        function adjustFont(delta) {
            currentSize = Math.max(0.9, Math.min(2.4, +(currentSize + (delta * 0.15)).toFixed(2)));
            applyFontSize();
        }

        function resetFontSize() {
            currentSize = 1.3;
            applyFontSize();
        }

        function toggleTocChapter(id) {
            const el = document.getElementById(id);
            if (!el) return;
            el.classList.toggle('collapsed');
            const collapsed = el.classList.contains('collapsed');
            const state = JSON.parse(localStorage.getItem('jsv-ml-toc-chapters') || '{}');
            state[id] = collapsed;
            localStorage.setItem('jsv-ml-toc-chapters', JSON.stringify(state));
        }

        function toggleTocSection(id) {
            const el = document.getElementById(id);
            if (!el) return;
            el.classList.toggle('collapsed');
            const collapsed = el.classList.contains('collapsed');
            const state = JSON.parse(localStorage.getItem('jsv-ml-toc-sections') || '{}');
            state[id] = collapsed;
            localStorage.setItem('jsv-ml-toc-sections', JSON.stringify(state));
        }

        function isMobileView() {
            const isTouch = window.matchMedia('(pointer: coarse)').matches;
            const isNarrow = window.innerWidth <= 600;
            const isTouchTablet = isTouch && window.innerWidth <= 850;
            const isTouchLandscape = isTouch && window.innerHeight <= 550 && window.matchMedia('(orientation: landscape)').matches;
            return isNarrow || isTouchTablet || isTouchLandscape;
        }

        function closeMobileToc() {
            document.body.classList.remove('mobile-toc-active');
            const btn = document.getElementById('sidebar-toggle-btn');
            if (btn) {
                const label = btn.getAttribute('data-label') || 'ഉള്ളടക്കം';
                if (isMobileView()) {
                    btn.textContent = '☰ ' + label;
                } else {
                    const collapsed = document.querySelector('.layout')?.classList.contains('sidebar-collapsed');
                    btn.textContent = collapsed ? '☰' : ('☰ ' + label);
                }
            }
        }

        function toggleSidebar() {
            const btn = document.getElementById('sidebar-toggle-btn');
            const label = btn ? (btn.getAttribute('data-label') || 'ഉള്ളടക്കം') : 'ഉള്ളടക്കം';
            if (isMobileView()) {
                document.body.classList.toggle('mobile-toc-active');
                const isOpen = document.body.classList.contains('mobile-toc-active');
                if (btn) btn.textContent = isOpen ? ('✕ ' + label) : ('☰ ' + label);
            } else {
                const layout = document.querySelector('.layout');
                if (!layout) return;
                layout.classList.toggle('sidebar-collapsed');
                const collapsed = layout.classList.contains('sidebar-collapsed');
                sessionStorage.setItem('jsv-ml-sidebar-collapsed', collapsed);
                if (btn) btn.textContent = collapsed ? '☰' : ('☰ ' + label);
            }
        }

        function handleLayoutChange() {
            const isMobile = isMobileView();
            const btn = document.getElementById('sidebar-toggle-btn');
            const layout = document.querySelector('.layout');
            const label = btn ? (btn.getAttribute('data-label') || 'ഉള്ളടക്കം') : 'ഉള്ളടക്കം';

            if (isMobile) {
                // Mobile view (narrow or touch device)
                if (layout) {
                    layout.classList.remove('sidebar-collapsed');
                }
                const isOpen = document.body.classList.contains('mobile-toc-active');
                if (btn) {
                    btn.textContent = isOpen ? ('✕ ' + label) : ('☰ ' + label);
                }
            } else {
                // Desktop landscape view
                // Dismiss mobile off-canvas drawer and backdrop
                document.body.classList.remove('mobile-toc-active');

                // Restore desktop sidebar collapsed state for active session only
                const collapsed = sessionStorage.getItem('jsv-ml-sidebar-collapsed') === 'true';
                if (layout) {
                    if (collapsed) layout.classList.add('sidebar-collapsed');
                    else layout.classList.remove('sidebar-collapsed');
                }
                if (btn) {
                    btn.textContent = collapsed ? '☰' : ('☰ ' + label);
                }
            }
        }

        /* Print Modal & High Performance Cached Printing */
        let currentActiveChapterId = null;
        let currentActiveChapterTitle = "";
        let currentActiveSectionId = null;
        let currentActiveSectionTitle = "";
        const printCache = new Map();

        function populateParvaDropdown() {
            const select = document.getElementById('parva-select-dropdown');
            if (!select) return;
            select.innerHTML = '';
            document.querySelectorAll('.chapter-container').forEach(ch => {
                const titleNode = ch.querySelector('.chapter-heading-text') || ch.querySelector('.chapter-heading');
                if (titleNode) {
                    const opt = document.createElement('option');
                    opt.value = ch.id;
                    opt.textContent = titleNode.textContent.trim();
                    select.appendChild(opt);
                }
            });
        }

        function populateKandahDropdown() {
            const select = document.getElementById('kandah-select-dropdown');
            if (!select) return;
            select.innerHTML = '';
            document.querySelectorAll('.chapter-container').forEach(ch => {
                const chTitle = ch.querySelector('.chapter-heading-text')?.textContent.trim() || ch.querySelector('.chapter-heading')?.textContent.trim() || '';
                ch.querySelectorAll('.section').forEach(sec => {
                    const titleNode = sec.querySelector('.section-title-text') || sec.querySelector('.section-title');
                    if (titleNode) {
                        const clone = titleNode.cloneNode(true);
                        const countNode = clone.querySelector('.section-samam-count');
                        if (countNode) clone.removeChild(countNode);
                        const btnNode = clone.querySelector('.btn-heading-print');
                        if (btnNode) clone.removeChild(btnNode);
                        const secTitle = clone.textContent.trim();
                        const opt = document.createElement('option');
                        opt.value = sec.id;
                        opt.textContent = (chTitle ? chTitle + ' — ' : '') + secTitle;
                        select.appendChild(opt);
                    }
                });
            });
        }

        function openPrintModal() {
            const modal = document.getElementById('print-modal');
            populateParvaDropdown();
            populateKandahDropdown();
            const kandahLabel = document.getElementById('current-kandah-print-name');
            if (kandahLabel) {
                kandahLabel.innerText = currentActiveSectionTitle ? currentActiveSectionTitle + ' (~1-3 pages)' : 'Active Kandah (~1-3 pages)';
            }
            const parvaLabel = document.getElementById('current-parva-print-name');
            if (parvaLabel) {
                parvaLabel.innerText = currentActiveChapterTitle ? currentActiveChapterTitle : 'Active Parva / Chapter';
            }
            if (modal) modal.style.display = 'flex';
        }

        function closePrintModal() {
            const modal = document.getElementById('print-modal');
            if (modal) modal.style.display = 'none';
        }

        // Intercept Ctrl+P / Cmd+P to open fast print modal instead of freezing
        window.addEventListener('keydown', function(e) {
            if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'p') {
                e.preventDefault();
                openPrintModal();
            }
        });

        function printHtmlContent(title, contentHtml) {
            let iframe = document.getElementById('jsv-print-frame');
            if (!iframe) {
                iframe = document.createElement('iframe');
                iframe.id = 'jsv-print-frame';
                iframe.style.position = 'fixed';
                iframe.style.right = '0';
                iframe.style.bottom = '0';
                iframe.style.width = '0';
                iframe.style.height = '0';
                iframe.style.border = 'none';
                iframe.style.visibility = 'hidden';
                document.body.appendChild(iframe);
            }
            const doc = iframe.contentWindow.document;
            const mainStyle = document.querySelector('style') ? document.querySelector('style').innerHTML : '';
            doc.open();
            doc.write(`<!DOCTYPE html>
            <html lang="ml">
            <head>
                <meta charset="UTF-8">
                <title>${title || document.title}</title>
                <style>
                    ${mainStyle}
                    @page {
                        size: auto;
                        margin: 12mm 15mm 12mm 15mm;
                    }
                    *, *::before, *::after {
                        box-sizing: border-box !important;
                    }
                    html, body {
                        background: white !important;
                        color: black !important;
                        margin: 0 !important;
                        padding: 0 !important;
                        font-size: 13pt !important;
                        width: 100% !important;
                        max-width: 100% !important;
                    }
                    .btn-heading-print {
                        display: none !important;
                    }
                    .print-container {
                        width: 100% !important;
                        max-width: 100% !important;
                        margin: 0 !important;
                        padding: 0 !important;
                        box-sizing: border-box !important;
                    }
                    .main-content {
                        border: none !important;
                        box-shadow: none !important;
                        padding: 0 !important;
                        width: 100% !important;
                        max-width: 100% !important;
                        box-sizing: border-box !important;
                    }
                    .chapter-container, .section {
                        margin-bottom: 2rem !important;
                        width: 100% !important;
                        max-width: 100% !important;
                        box-sizing: border-box !important;
                    }
                    .subsection {
                        background: none !important;
                        box-shadow: none !important;
                        border: 1px solid #CCC !important;
                        border-left: 4px solid #D84315 !important;
                        border-radius: 6px !important;
                        padding: 10px 14px !important;
                        margin-bottom: 1.2rem !important;
                        width: 100% !important;
                        max-width: 100% !important;
                        box-sizing: border-box !important;
                        break-inside: auto !important;
                        page-break-inside: auto !important;
                    }
                    .mantra-verse {
                        break-inside: auto !important;
                        page-break-inside: auto !important;
                        width: 100% !important;
                        max-width: 100% !important;
                        flex-wrap: wrap !important;
                        box-sizing: border-box !important;
                    }
                    .mantra-connected-group {
                        max-width: 100% !important;
                        flex-wrap: wrap !important;
                    }
                    ruby.vedic-ruby {
                        display: inline-flex !important;
                        flex-direction: column-reverse !important;
                        align-items: center !important;
                        vertical-align: bottom !important;
                    }
                    rt.swara-above {
                        font-size: 0.85em !important;
                        color: #c62828 !important;
                    }
                    @media print {
                        body { margin: 0 !important; padding: 0 !important; }
                    }
                </style>
            </head>
            <body>
                <div class="print-container">
                    ${contentHtml}
                </div>
            </body>
            </html>`);
            doc.close();

            setTimeout(() => {
                iframe.contentWindow.focus();
                iframe.contentWindow.print();
            }, 100);
        }

        function getSectionPrintableHtml(target) {
            if (!target) return "";
            const targetId = target.id;
            if (printCache.has(targetId)) {
                return printCache.get(targetId);
            }
            const parentChapter = target.closest('.chapter-container');
            const chTitleNode = parentChapter ? (parentChapter.querySelector('.chapter-heading-text') || parentChapter.querySelector('.chapter-heading')) : null;
            const chapterHeaderHtml = chTitleNode ? `<h2 class="chapter-heading" style="text-align:center;font-size:1.35rem;margin-bottom:1.2rem;color:#7B1113;border-bottom:2px solid #7B1113;padding-bottom:0.4rem;">${chTitleNode.textContent.trim()}</h2>` : '';
            const docTitleHtml = `<div style="text-align:center;margin-bottom:1rem;"><h1 style="font-size:1.55rem;color:#7B1113;margin-bottom:0.3rem;">॥ ${document.title} ॥</h1></div>`;
            const fullHtml = docTitleHtml + chapterHeaderHtml + target.outerHTML;
            printCache.set(targetId, fullHtml);
            return fullHtml;
        }

        function getSupersectionPrintableHtml(target) {
            if (!target) return "";
            const targetId = 'supersection-' + target.id;
            if (printCache.has(targetId)) {
                return printCache.get(targetId);
            }
            const docTitleHtml = `<div style="text-align:center;margin-bottom:1rem;"><h1 style="font-size:1.55rem;color:#7B1113;margin-bottom:0.3rem;">॥ ${document.title} ॥</h1></div>`;
            const fullHtml = docTitleHtml + target.outerHTML;
            printCache.set(targetId, fullHtml);
            return fullHtml;
        }

        function printActiveKandah() {
            closePrintModal();
            let target = currentActiveSectionId ? document.getElementById(currentActiveSectionId) : null;
            if (!target) target = document.querySelector('.section');
            if (!target) return;
            const printableHtml = getSectionPrintableHtml(target);
            const title = currentActiveSectionTitle || document.title;
            printHtmlContent(title, printableHtml);
        }

        function printActiveParva() {
            closePrintModal();
            let target = currentActiveChapterId ? document.getElementById(currentActiveChapterId) : null;
            if (!target) target = document.querySelector('.chapter-container');
            if (!target) return;
            const printableHtml = getSupersectionPrintableHtml(target);
            const title = currentActiveChapterTitle || document.title;
            printHtmlContent(title, printableHtml);
        }

        function printSelectedKandah() {
            const select = document.getElementById('kandah-select-dropdown');
            if (!select || !select.value) return;
            const target = document.getElementById(select.value);
            if (!target) return;
            closePrintModal();
            const printableHtml = getSectionPrintableHtml(target);
            const title = select.options[select.selectedIndex]?.text || document.title;
            printHtmlContent(title, printableHtml);
        }

        function printSelectedParva() {
            const select = document.getElementById('parva-select-dropdown');
            if (!select || !select.value) return;
            const target = document.getElementById(select.value);
            if (!target) return;
            closePrintModal();
            const printableHtml = getSupersectionPrintableHtml(target);
            const title = select.options[select.selectedIndex]?.text || document.title;
            printHtmlContent(title, printableHtml);
        }

        function printEntireDocument() {
            closePrintModal();
            setTimeout(function() {
                window.print();
            }, 50);
        }

        /* Context-aware Suchi / Index Scroll Synchronization */
        let activeSamamId = null;
        let isUserInteractingWithToc = false;

        function scrollSidebarToTarget(targetLink) {
            const sidebar = document.getElementById('toc-sidebar');
            if (!sidebar || isUserInteractingWithToc) return;
            const linkRect = targetLink.getBoundingClientRect();
            const sideRect = sidebar.getBoundingClientRect();
            const margin = Math.min(70, sideRect.height * 0.2);
            if (linkRect.top < sideRect.top + margin || linkRect.bottom > sideRect.bottom - margin) {
                const currentScroll = sidebar.scrollTop;
                const offset = (linkRect.top - sideRect.top) - (sideRect.height / 2) + (linkRect.height / 2);
                sidebar.scrollTo({
                    top: Math.max(0, currentScroll + offset),
                    behavior: 'smooth'
                });
            }
        }

        function highlightSamamInToc(samamId) {
            if (!samamId || samamId === activeSamamId) return;
            activeSamamId = samamId;

            // Handle special non-subsection targets: summary-table and index
            if (samamId === 'summary-table' || samamId === 'index') {
                document.querySelectorAll('.toc-sub-item a.active').forEach(el => el.classList.remove('active'));
                document.querySelectorAll('.toc-sec-header.active').forEach(el => el.classList.remove('active'));
                document.querySelectorAll('.toc-chapter.active-chapter').forEach(el => el.classList.remove('active-chapter'));
                const specialLink = document.querySelector(`.toc-ch-title a[href="#${samamId}"]`);
                if (specialLink) {
                    const parentCh = specialLink.closest('.toc-chapter');
                    if (parentCh) parentCh.classList.add('active-chapter');
                    scrollSidebarToTarget(specialLink);
                }
                return;
            }

            let targetLink = document.querySelector(`.toc-sub-item a[href="#${samamId}"]`);
            if (!targetLink) {
                const targetNode = document.getElementById(samamId);
                if (targetNode) {
                    const firstSub = targetNode.querySelector('.subsection');
                    if (firstSub) {
                        targetLink = document.querySelector(`.toc-sub-item a[href="#${firstSub.id}"]`);
                    }
                }
            }
            if (!targetLink) return;

            // Remove previous active highlights
            document.querySelectorAll('.toc-sub-item a.active').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.toc-sec-header.active').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.toc-chapter.active-chapter').forEach(el => el.classList.remove('active-chapter'));

            // Highlight the active Samam link
            targetLink.classList.add('active');

            let wasCollapsed = false;

            // Uncollapse parent Kandah and mark active
            const parentSec = targetLink.closest('.toc-section-block');
            if (parentSec) {
                if (parentSec.classList.contains('collapsed')) {
                    parentSec.classList.remove('collapsed');
                    wasCollapsed = true;
                }
                const secHeader = parentSec.querySelector('.toc-sec-header');
                if (secHeader) secHeader.classList.add('active');
            }

            // Uncollapse parent Chapter and mark active
            const parentCh = targetLink.closest('.toc-chapter');
            if (parentCh) {
                if (parentCh.classList.contains('collapsed')) {
                    parentCh.classList.remove('collapsed');
                    wasCollapsed = true;
                }
                parentCh.classList.add('active-chapter');
            }

            // Smoothly scroll the sidebar to keep active Samam centered in view
            if (wasCollapsed) {
                setTimeout(() => scrollSidebarToTarget(targetLink), 150);
            } else {
                scrollSidebarToTarget(targetLink);
            }
        }

        // IntersectionObserver for tracking current section during scroll
        document.addEventListener('DOMContentLoaded', function() {
            populateParvaDropdown();
            populateKandahDropdown();

            // Track active Samam during scroll and sync Suchi / Index
            const samamObserver = new IntersectionObserver((entries) => {
                let bestEntry = null;
                let minDistance = Infinity;

                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const dist = Math.abs(entry.boundingClientRect.top - 85);
                        if (dist < minDistance) {
                            minDistance = dist;
                            bestEntry = entry;
                        }
                    }
                });

                if (bestEntry) {
                    const targetEl = bestEntry.target;
                    highlightSamamInToc(targetEl.id);
                    currentActiveSectionId = targetEl.id;

                    const sec = targetEl.closest('.section');
                    if (sec) {
                        const titleNode = sec.querySelector('.section-title-text') || sec.querySelector('.section-title');
                        if (titleNode) {
                            const clone = titleNode.cloneNode(true);
                            const countNode = clone.querySelector('.section-samam-count');
                            if (countNode) clone.removeChild(countNode);
                            const btnNode = clone.querySelector('.btn-heading-print');
                            if (btnNode) clone.removeChild(btnNode);
                            currentActiveSectionTitle = clone.textContent.trim();
                        }
                    }
                    const ch = targetEl.closest('.chapter-container');
                    if (ch) {
                        currentActiveChapterId = ch.id;
                        const chTitle = ch.querySelector('.chapter-heading-text') || ch.querySelector('.chapter-heading');
                        if (chTitle) currentActiveChapterTitle = chTitle.textContent.trim();
                    }
                }
            }, { rootMargin: '-75px 0px -75% 0px', threshold: 0 });

            document.querySelectorAll('.subsection, #summary-table, #index').forEach(el => samamObserver.observe(el));

            // Direct click on Suchi item immediately highlights and smoothly scrolls to target
            document.querySelectorAll('.toc-sub-item a, .toc-ch-title a, .toc-sec-title').forEach(link => {
                link.addEventListener('click', function(e) {
                    if (isMobileView()) {
                        closeMobileToc();
                    }
                    const href = this.getAttribute('href');
                    if (href && href.startsWith('#')) {
                        const targetId = href.slice(1);
                        const target = document.getElementById(targetId);
                        if (target) {
                            e.preventDefault();
                            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                            if (history.pushState) {
                                history.pushState(null, '', href);
                            }
                            highlightSamamInToc(targetId);
                        }
                    }
                });
            });

            // Close mobile Suchi on Escape key
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    closeMobileToc();
                }
            });

            function onOrientationOrResize() {
                handleLayoutChange();
                const viewportMeta = document.querySelector('meta[name="viewport"]');
                if (viewportMeta) {
                    viewportMeta.setAttribute('content', 'width=device-width, initial-scale=1.0, viewport-fit=cover');
                }
            }

            // Trap window resize
            window.addEventListener('resize', onOrientationOrResize);

            // Trap mobile device orientation change (both legacy and modern APIs)
            window.addEventListener('orientationchange', function() {
                setTimeout(onOrientationOrResize, 50);
                setTimeout(onOrientationOrResize, 150);
                setTimeout(onOrientationOrResize, 350);
            });

            if (window.screen && window.screen.orientation) {
                window.screen.orientation.addEventListener('change', function() {
                    setTimeout(onOrientationOrResize, 50);
                    setTimeout(onOrientationOrResize, 150);
                    setTimeout(onOrientationOrResize, 350);
                });
            }

            const mqlPortrait = window.matchMedia('(orientation: portrait)');
            if (mqlPortrait.addEventListener) {
                mqlPortrait.addEventListener('change', onOrientationOrResize);
            } else if (mqlPortrait.addListener) {
                mqlPortrait.addListener(onOrientationOrResize);
            }

            // Wheel detection on sidebar so manual browsing isn't fought by scroll-spy
            const sidebar = document.getElementById('toc-sidebar');
            if (sidebar) {
                let tocTimeout;
                sidebar.addEventListener('wheel', () => {
                    isUserInteractingWithToc = true;
                    clearTimeout(tocTimeout);
                    tocTimeout = setTimeout(() => { isUserInteractingWithToc = false; }, 1500);
                }, { passive: true });
            }

            // Initial hash arrival check
            if (window.location.hash) {
                const hashTarget = document.getElementById(window.location.hash.slice(1));
                if (hashTarget) {
                    setTimeout(() => {
                        hashTarget.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }, 150);
                }
            }

            // Synchronize initial layout state based on screen orientation and width
            handleLayoutChange();
            const tocState = JSON.parse(localStorage.getItem('jsv-ml-toc-chapters') || '{}');
            for (const [id, isCollapsed] of Object.entries(tocState)) {
                const el = document.getElementById(id);
                if (el) {
                    if (isCollapsed) el.classList.add('collapsed');
                    else el.classList.remove('collapsed');
                }
            }
            const secState = JSON.parse(localStorage.getItem('jsv-ml-toc-sections') || '{}');
            for (const [id, isCollapsed] of Object.entries(secState)) {
                const el = document.getElementById(id);
                if (el) {
                    if (isCollapsed) el.classList.add('collapsed');
                    else el.classList.remove('collapsed');
                }
            }
            const savedFont = localStorage.getItem('jsv-ml-reader-font-idx');
            if (savedFont !== null) {
                setFont(parseInt(savedFont, 10) || 0);
            }
            const savedSize = localStorage.getItem('jsv-ml-reader-font-size');
            if (savedSize !== null) {
                currentSize = parseFloat(savedSize) || 1.3;
                applyFontSize();
            } else {
                updateFontSizeDisplay();
            }
        });

        // Back to top button visibility on scroll
        window.addEventListener('scroll', function() {
            const btn = document.getElementById('back-to-top');
            if (btn) {
                if (window.scrollY > 350) {
                    btn.classList.add('visible');
                } else {
                    btn.classList.remove('visible');
                }
            }
        });
    </script>
    <!-- Floating Back to Top Button -->
    <button id="back-to-top" class="back-to-top" onclick="window.scrollTo({top: 0, behavior: 'smooth'})" title="Go to top of page">▲</button>
</body>
</html>
