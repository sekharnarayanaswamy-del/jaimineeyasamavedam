<!DOCTYPE html>
<html lang="sa">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>॥ \VAR{doc_title_sa} ॥</title>
    <style>
        :root {
            --primary-color:  #000000;
            --accent-blue: #0d47a1;
            --accent-green: #1b5e20;
            --accent-purple: #4a148c;
            --accent-brown: #4e342e;
            --swara-red: #b71c1c;
            --bg-light: #f8f9fa;
            --bg-card: #EFE6D5;
            --border-color: #dee2e6;
        }
        
        * {
            box-sizing: border-box;
        }

        /* Custom Superscript for footnotes - Lift it up! */
        sup {
            vertical-align: top;
            position: relative;
            top: -0.6em; /* Adjust this to move it higher */
            font-size: 0.75em;
        }
        
        body {
            font-family: \VAR{html_font}, 'Noto Sans Devanagari', 'Siddhanta', 'Arial Unicode MS', sans-serif;
            font-size: 1.3rem;
            line-height: 1.8;
            color: var(--primary-color);
            background: var(--bg-light);
            margin: 0;
            padding: 0;
        }
        
        .container {
            max-width: 900px;
            margin: 0 auto;
            padding: 20px;
            background: white;
            min-height: 100vh;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
        }
        
        /* Header Styles */
        .title-page {
            text-align: center;
            padding: 60px 20px;
            border-bottom: 2px solid var(--border-color);
            margin-bottom: 40px;
        }
        
        .title-page h1 {
            font-size: 2.5rem;
            color: var(--primary-color);
            margin: 0;
        }
        
        /* Table of Contents */
        .toc {
            padding: 20px;
            background: var(--bg-light);
            border-radius: 8px;
            margin-bottom: 40px;
        }
        
        .toc h2 {
            text-align: center;
            color: var(--primary-color);
            margin-top: 0;
            margin-bottom: 20px;
        }
        
        .toc-content {
            display: block;
        }
        
        .toc-group {
            break-inside: avoid;
            margin-bottom: 30px;
        }
        
        .toc ul {
            list-style: none;
            padding-left: 0;
            margin: 0;
            columns: 3;
            column-gap: 40px;
        }
        
        .toc a {
            color: var(--accent-blue);
            text-decoration: none;
        }
        
        .toc a:hover {
            text-decoration: underline;
        }
        
        .toc-chapter {
            font-weight: bold;
            font-size: 1.75rem;
            margin-bottom: 12px;
            color: var(--primary-color);
            text-align: left;
            white-space: nowrap;
        }
        
        .toc-section {
            padding: 3px 0;
            font-size: 1.5rem;
            line-height: 1.4;
            text-align: left;
        }
        
        /* Chapter/Section Styles */
        .chapter {
            page-break-before: always;
            margin-top: 40px;
            padding-top: 20px;
            border-top: 3px solid var(--accent-purple);
        }
        
        .chapter-title {
            text-align: center;
            font-size: 2rem;
            color: var(--primary-color);
            margin-bottom: 30px;
        }
        
        .section {
            margin-top: 30px;
            padding-top: 15px;
            border-top: 1px solid var(--border-color);
        }
        
        .section-title {
            text-align: center;
            font-size: 1.5rem;
            color: var(--primary-color); 
            margin-bottom: 8px;
        }
        
        /* Mantra Styles */
        .subsection {
            margin: 0;
            padding: 3px 10px;
            background: var(--bg-card);
            border-left: 4px solid var(--accent-blue);
            text-align: center;
        }
        
        .rik-metadata {
            text-align: center;
            color: var(--accent-purple);
            font-size: 1.5rem;
            margin: 0;
        }
        
        .rik-text {
            text-align: center;
            color: var(--accent-blue);
            font-size: 1.5rem;
            margin-bottom: 0;
        }
        
        .subsection-header {
            text-align: center;
            font-size: 1.5rem;
            margin-bottom: 5px;
        }
        
        .subsection-header .header-title {
            color: var(--accent-green);
            font-weight: bold;
        }
        
        .subsection-header .header-meta {
            color: var(--accent-brown);
        }
        
        /* Mantra display - flexbox for no whitespace and natural wrapping */
        .mantra-verse {
            margin: 5px 0;
            display: inline-flex;
            flex-wrap: wrap;
            align-items: flex-start;
            text-align: center;
            gap: 0;
        }
        
        /* Wrapper to center the inline-flex mantra-verse */
        .subsection {
            text-align: center;
        }
        
        .mantra-word {
            display: inline-flex;
            flex-direction: column;
            align-items: stretch;
            vertical-align: top;
            margin: 0;
            padding: 0;
        }
        
        .mantra-text {
            font-family: \VAR{html_font}, 'Noto Sans Devanagari', 'Siddhanta', sans-serif;
            font-size: 1.5rem;
            line-height: 1.2;
        }
        
        .swara-text {
            font-family: \VAR{html_font}, 'Noto Sans Devanagari', 'Siddhanta', sans-serif;
            color: var(--swara-red);
            font-size: 1.25rem;
            line-height: 1;
            text-align: center;
            margin-top: -0.3em;
            min-height: 1em;
            border-right: 1px solid transparent;
            padding-right: 2px;
        }
        
        .word-space {
            width: 0.3em;
        }
        
        /* Danda and Mantra Number */
        .danda {
            margin: 0 0.2em;
        }
        
        .mantra-number {
            display: inline-block;
            white-space: nowrap;
            color: var(--primary-color);
            font-weight: bold;
        }
        
        /* Accent marks - zero-width positioning for fonts without native Vedic support */
        .accent-swarita {
            display: inline-block;
            width: 0;
            overflow: visible;
            color: var(--accent-blue);
            font-weight: bold;
            font-size: 1.2em;
            position: relative;
            left: -0.1em;
            top: -0.15em;
        }
        
        .accent-anudatta {
            display: inline-block;
            width: 0;
            overflow: visible;
            color: var(--accent-blue);
            font-weight: bold;
            font-size: 1.2em;
            position: relative;
            left: -0.1em;
            top: -0.15em;
        }
        
        .accent-kampa {
            display: inline-block;
            width: 0;
            overflow: visible;
            color: var(--accent-blue);
            font-weight: bold;
            font-size: 1.2em;
            position: relative;
            left: -0.1em;
            top: -0.15em;
        }
        
        .accent-trikampa {
            display: inline-block;
            width: 0;
            overflow: visible;
            color: var(--accent-blue);
            font-weight: bold;
            font-size: 1.2em;
            position: relative;
            left: -0.1em;
            top: -0.15em;
        }
        
        /* Footnote Section Styles */
        .footnote-separator {
            border: none;
            border-top: 1px solid var(--border-color);
            margin: 20px 0 10px 0;
            width: 40%;
            margin-left: 0;
        }
        
        .footnote-section {
            padding: 10px 0;
            text-align: left;
            font-size: 0.9rem;
            line-height: 1.5;
        }
        
        .footnote-item {
            padding: 5px 0;
            display: flex;
            align-items: flex-start;
        }
        
        .footnote-item .footnote-ref {
            color: var(--accent-blue);
            font-weight: bold;
            margin-right: 0.5em;
            min-width: 1.5em;
        }
        
        /* Footer */
        .footer {
            text-align: center;
            padding: 30px 20px;
            margin-top: 40px;
            border-top: 2px solid var(--border-color);
            background: white;
            color: var(--primary-color);
            font-size: 1rem;
        }
        
        .footer a {
            color: var(--accent-blue);
            text-decoration: none;
            font-weight: bold;
        }
        
        .footer a:hover {
            text-decoration: underline;
        }
        
        /* Responsive */
        @media (max-width: 768px) {
            body {
                font-size: 1.3rem;
            }
            
            .container {
                padding: 10px;
            }
            
            .title-page h1 {
                font-size: 1.8rem;
            }
            
            .subsection {
                padding: 10px;
            }
        }
        
        /* Print styles */
        @media print {
            .container {
                box-shadow: none;
                max-width: 100%;
            }
            
            .chapter {
                page-break-before: always;
            }
            
            .subsection {
                page-break-inside: avoid;
            }
        }
        
        /* Navigation */
        .nav-bar {
            position: sticky;
            top: 0;
            background: white;
            padding: 10px 20px;
            border-bottom: 1px solid var(--border-color);
            z-index: 100;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .nav-bar a {
            color: var(--accent-blue);
            text-decoration: none;
            padding: 5px 10px;
            font-size: 1.3rem;
        }
        
        .nav-bar a:hover {
            background: var(--bg-light);
            border-radius: 4px;
        }
        
        .nav-titles {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            text-align: right;
        }
        
        .nav-main-title {
            font-weight: bold;
            font-size: 1.3rem;
        }
        
        .nav-section-title {
            font-size: 1.3rem;
            color: var(--accent-green);
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Navigation -->
        <nav class="nav-bar">
            <div class="nav-left-links" style="display: flex; flex-direction: column; align-items: flex-start;">
                <a href="#toc">॥ अनुक्रमणिका ॥</a>
                \BLOCK{ if html_index }
                <a href="#index">॥ वर्णानुक्रमणिका ॥</a>
                \BLOCK{ endif }
            </div>
            <div class="nav-titles">
                <span class="nav-main-title">॥ \VAR{doc_title_sa} ॥</span>
                <span id="nav-title" class="nav-section-title"></span>
            </div>
        </nav>
        
        <script>
        // Dynamic nav bar title based on scroll position
        document.addEventListener('DOMContentLoaded', function() {
            const navTitle = document.getElementById('nav-title');
            const defaultTitle = '॥ \VAR{doc_title_sa} ॥';
            
            // Build section data for tracking
            const sections = [];
            document.querySelectorAll('.chapter, .section').forEach(el => {
                if (el.classList.contains('section')) {
                    const chapter = el.closest('.chapter');
                    const chapterTitle = chapter ? chapter.querySelector('.chapter-title')?.textContent : '';
                    
                    let sectionTitle = '';
                    const sectionTitleNode = el.querySelector('.section-title');
                    if (sectionTitleNode) {
                        const clone = sectionTitleNode.cloneNode(true);
                        const countNode = clone.querySelector('.section-samam-count');
                        if (countNode) clone.removeChild(countNode);
                        sectionTitle = clone.textContent.trim();
                    }
                    
                    sections.push({
                        element: el,
                        chapterTitle: chapterTitle,
                        sectionTitle: sectionTitle
                    });
                } else if (el.classList.contains('chapter') && !el.querySelector('.section')) {
                    // Standalone chapter without sections (like summary table, index)
                    const chapterTitle = el.querySelector('.chapter-title')?.textContent || '';
                    sections.push({
                        element: el,
                        chapterTitle: chapterTitle,
                        sectionTitle: ''
                    });
                }
            });
            
            // Use IntersectionObserver for efficient scroll tracking
            const observerOptions = {
                root: null,
                rootMargin: '-80px 0px -70% 0px', // Trigger when section is near top of viewport
                threshold: 0
            };
            
            let currentSection = null;
            
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const sectionData = sections.find(s => s.element === entry.target);
                        if (sectionData) {
                            currentSection = sectionData;
                            if (sectionData.sectionTitle) {
                                navTitle.textContent = sectionData.chapterTitle + ' › ' + sectionData.sectionTitle;
                            } else {
                                navTitle.textContent = sectionData.chapterTitle;
                            }
                        }
                    }
                });
            }, observerOptions);
            
            sections.forEach(s => observer.observe(s.element));
            
            // Clear section title when scrolled to top
            window.addEventListener('scroll', function() {
                if (window.scrollY < 200) {
                    navTitle.textContent = '';
                }
            });
        });
        </script>
        
        <!-- Title Page -->
        <div class="title-page">
            <h1>॥ \VAR{doc_title_sa} ॥</h1>
            <p style="font-size: 1.2rem; margin-top: 10px; color: var(--accent-blue);">
                संस्करणम्: \VAR{version} | निर्मितम्: \VAR{generated_at}
            </p>
        </div>
        
        <!-- Table of Contents -->
        <div class="toc" id="toc">
            <h2>॥ अनुक्रमणिका ॥</h2>
            <div class="toc-content">
            \BLOCK{ for key, supersection in supersections.items() }
                <div class="toc-group">
                    <div class="toc-chapter">
                        <a href="#\VAR{key}">\VAR{supersection.supersection_title}</a>
                    </div>
                    <ul>
                    \BLOCK{ for section_key, section in supersection.sections.items() }
                        \BLOCK{ if section_key != 'count' }
                        \BLOCK{ if toc_level == 'section' or toc_level == 'both' }
                        <li class="toc-section">
                            <a href="#\VAR{key}-\VAR{section_key}">\VAR{section.section_title | replace(':', 'ः')}</a>
                        </li>
                        \BLOCK{ endif }
                        \BLOCK{ if toc_level == 'subsection' or toc_level == 'both' }
                            \BLOCK{ for subsection_key, subsection in section.subsections.items() }
                            <li class="toc-section" style="margin-left: \VAR{'20px' if toc_level == 'both' else '0px'}; font-size: 1.3rem;">
                                <a href="#\VAR{key}-\VAR{section_key}-\VAR{subsection_key}">\VAR{subsection.header.header | replace(':', 'ः') | replace('|', '') | replace('॥', '')}</a>
                            </li>
                            \BLOCK{ endfor }
                        \BLOCK{ endif }
                        \BLOCK{ endif }
                    \BLOCK{ endfor }
                    </ul>
                </div>
            \BLOCK{ endfor }
            </div>
        </div>
        
        <!-- Content -->
        \BLOCK{ for key, supersection in supersections.items() }
        <div class="chapter" id="\VAR{key}">
            <h1 class="chapter-title">\VAR{supersection.supersection_title}</h1>
            
            \BLOCK{ for section_key, section in supersection.sections.items() }
                \BLOCK{ if section_key != 'count' }
                <div class="section" id="\VAR{key}-\VAR{section_key}">
                    <h2 class="section-title">\VAR{section.section_title | replace(':', 'ः')}<span class="section-samam-count">&emsp;&emsp;(\VAR{section.Count})</span></h2>
                    
                    <!-- Pre-rendered Subsections -->
                    \BLOCK{ for sub_html in section.html_subsections }
                    <div class="subsection" id="\VAR{sub_html.id}">
                        \VAR{sub_html.content}
                    </div>
                    \BLOCK{ endfor }

                    <!-- Pre-rendered Footnotes -->
                    \VAR{section.html_footer}
                </div>
                \BLOCK{ endif }
            \BLOCK{ endfor }
        </div>
        \BLOCK{ endfor }
        
        \BLOCK{ if closing_mantras }
        <!-- Closing Mantras -->
        <div class="section" id="closing-mantras">
            <div class="subsection" style="padding: 30px 20px; margin: 20px 0;">
                \BLOCK{ for line in closing_mantras }
                <p style="font-size: 1.5rem; margin: 8px 0; text-align: center;">\VAR{line}</p>
                \BLOCK{ endfor }
            </div>
        </div>
        \BLOCK{ endif }
        
        \BLOCK{ if summary_table }
        <!-- Summary Table -->
        <div class="chapter" id="summary-table">
            <h1 class="chapter-title">॥ \VAR{summary_title} ॥</h1>
            <div style="overflow-x: auto; padding: 10px; display: flex; justify-content: center;">
                <table style="width: 80%; max-width: 800px; border-collapse: collapse; margin-bottom: 20px; text-align: center; border: 1px solid var(--border-color);">
                    <thead>
                        <tr style="background-color: var(--bg-card); border-bottom: 2px solid var(--accent-purple);">
                            <th style="padding: 8px; border: 1px solid var(--border-color);">खण्डः</th>
                            <th style="padding: 8px; border: 1px solid var(--border-color);">ऋक् सङ्ख्या</th>
                            <th style="padding: 8px; border: 1px solid var(--border-color);">साम सङ्ख्या</th>
                        </tr>
                    </thead>
                    <tbody>
                        \BLOCK{ for patha_data in summary_table }
                            <tr style="background-color: var(--bg-light); font-weight: bold;">
                                <td style="padding: 8px; border: 1px solid var(--border-color); color: var(--accent-blue);">\VAR{patha_data.patha}</td>
                                <td style="padding: 8px; border: 1px solid var(--border-color); color: var(--accent-blue);">\VAR{patha_data.patha_riks}</td>
                                <td style="padding: 8px; border: 1px solid var(--border-color); color: var(--accent-blue);">\VAR{patha_data.patha_samams}</td>
                            </tr>
                            \BLOCK{ for row in patha_data.khandas }
                            <tr>
                                <td style="padding: 6px; border: 1px solid var(--border-color); text-align: left; padding-left: 20px;">\VAR{row.khanda}</td>
                                <td style="padding: 6px; border: 1px solid var(--border-color);">\VAR{row.riks}</td>
                                <td style="padding: 6px; border: 1px solid var(--border-color);">\VAR{row.samams}</td>
                            </tr>
                            \BLOCK{ endfor }
                        \BLOCK{ endfor }
                    </tbody>
                    <tfoot>
                        <tr style="background-color: var(--bg-light); font-weight: bold; border-top: 2px solid var(--accent-blue);">
                            <td style="padding: 8px; border: 1px solid var(--border-color); text-align: center;">आहत्य (Total)</td>
                            <td style="padding: 8px; border: 1px solid var(--border-color);">\VAR{total_riks}</td>
                            <td style="padding: 8px; border: 1px solid var(--border-color);">\VAR{total_samams}</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
        \BLOCK{ endif }
        
        \BLOCK{ if html_index }
        <!-- Index -->
        <div class="chapter" id="index">
            <h1 class="chapter-title">॥ वर्णानुक्रमणिका ॥</h1>
            <div class="toc-content" style="display: block; columns: 3 200px; padding: 0 20px;">
                <ul style="list-style: none; padding-left: 0; margin: 0;">
                \BLOCK{ for entry in html_index }
                    <li style="margin-bottom: 5px; text-align: left;">
                        <a href="#\VAR{entry.anchor}" style="text-decoration: none; color: var(--accent-blue); font-size: 1.1rem; word-break: break-word; display: inline-block;">\VAR{entry.title}</a>
                    </li>
                \BLOCK{ endfor }
                </ul>
            </div>
        </div>
        \BLOCK{ endif }
        
    </div>
    
    <footer class="footer">
        <p>Visit us at <a href="https://jaimineeyasamavedam.org" target="_blank">jaimineeyasamavedam.org</a></p>
    </footer>
</body>
</html>
